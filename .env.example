# Copy to .env and adjust. EXPO_PUBLIC_* values are baked into the bundle: restart with `npx expo start -c` after changes.
# See docs/run-and-release.md for dev (Wi-Fi / mobile data) and release values.

# Backend base URL, no trailing slash.
#   Wi-Fi dev:      http://<this PC's LAN IP>:2069
#   Mobile-data dev: the https://….trycloudflare.com URL printed by scripts\api-tunnel.cmd
#   Release:        https://myqode.qodeinvest.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.200.100:2069

# 1 while testing with real clients (blocks emails, password changes, push registration, hides the update banner). 0 for release.
EXPO_PUBLIC_TEST_MODE=1

# 1 shows the passwordless sign-in (server must run NODE_ENV=development). 0 for release.
EXPO_PUBLIC_DEV_BYPASS=1
