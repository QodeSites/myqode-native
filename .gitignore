# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local env
.env
/build

# local environment variants (never committed)
.env.production
.env.backup-*

# Firebase service-account keys are secrets: never commit them (upload to Expo, then keep them out of the repo)
*-firebase-adminsdk-*.json
