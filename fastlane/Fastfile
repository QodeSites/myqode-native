# Store releases for myQode (com.qodeinvest.myqode). Builds are made by scripts/release.sh; these lanes put them,
# the screenshots and the release notes into the stores and submit them for review. Nothing here ever releases to
# the public: Apple is submitted with "Manually release this version", Play is uploaded as a draft (or a halted
# staged rollout) until someone presses Release / Publish.
#
# Keys (never in git; see fastlane/README.md):
#   ~/.appstore/AuthKey_<KEYID>.p8          App Store Connect API key, App Manager role
#   ~/.appstore/play-service-account.json   Google Play service account, Release manager on myQode
#
# Lanes:
#   fastlane ios metadata              screenshots + texts only (no submission)
#   fastlane ios submit build:202610040135   attach that build, manual release, submit for review
#   fastlane ios release               press "Release This Version" (only when told to)
#   fastlane android metadata          Play screenshots + texts only
#   fastlane android submit aab:~/Desktop/qode/apk/myQode-1.3.0-52.aab   upload to production as a DRAFT
#   fastlane android release code:52 rollout:0.2   publish the draft to 20% (1.0 = everyone; only when told to)

APP_ID = "com.qodeinvest.myqode"
KEY_DIR = File.expand_path("~/.appstore")
VERSION = JSON.parse(File.read(File.expand_path("../app.json", __dir__)))["expo"]["version"]

def asc_key
  p8 = Dir[File.join(KEY_DIR, "AuthKey_*.p8")].first
  UI.user_error!("No App Store Connect API key: put AuthKey_<KEYID>.p8 in ~/.appstore/") unless p8
  issuer = ENV["ASC_ISSUER_ID"] || File.read(File.expand_path("../scripts/ios-testflight.sh", __dir__))[/ASC_ISSUER_ID:-([0-9a-f-]{36})/, 1]
  app_store_connect_api_key(key_id: File.basename(p8, ".p8").sub("AuthKey_", ""), issuer_id: issuer, key_filepath: p8, duration: 1200)
end

def play_key
  json = File.join(KEY_DIR, "play-service-account.json")
  UI.user_error!("No Play service account: put it at ~/.appstore/play-service-account.json") unless File.exist?(json)
  json
end

platform :ios do
  desc "Read-only: can the key see the app? Lists its versions and the newest builds"
  lane :check do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_key)
    app = Spaceship::ConnectAPI::App.find(APP_ID) || UI.user_error!("Key cannot see #{APP_ID}")
    UI.success("App Store: #{app.name} (#{app.bundle_id})")
    app.get_app_store_versions.first(3).each { |v| UI.message("  version #{v.version_string}: #{v.app_store_state}") }
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 3).each do |b|
      UI.message("  build #{b.version} (#{b.app_version}): #{b.processing_state}")
    end
  end

  desc "Upload screenshots and texts to the App Store version (no submission)"
  lane :metadata do
    deliver(api_key: asc_key, app_identifier: APP_ID, app_version: VERSION, platform: "ios",
            skip_binary_upload: true, skip_app_version_update: false, overwrite_screenshots: true,
            screenshots_path: File.expand_path("screenshots/ios", __dir__),
            metadata_path: File.expand_path("metadata/ios", __dir__),
            submit_for_review: false, automatic_release: false, force: true, precheck_include_in_app_purchases: false,
            run_precheck_before_submit: false)
  end

  desc "Attach a processed build, set manual release, submit for App Review"
  lane :submit do |options|
    build = options[:build] || UI.user_error!("Pass build:<number>, e.g. build:202610040135")
    deliver(api_key: asc_key, app_identifier: APP_ID, app_version: VERSION, platform: "ios", build_number: build.to_s,
            skip_binary_upload: true, overwrite_screenshots: true,
            screenshots_path: File.expand_path("screenshots/ios", __dir__),
            metadata_path: File.expand_path("metadata/ios", __dir__),
            submit_for_review: true, automatic_release: false, phased_release: false, force: true,
            precheck_include_in_app_purchases: false,
            submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false })
  end

  desc "Release the approved version to the App Store (Pending Developer Release → live)"
  lane :release do
    api = asc_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    v = app.get_pending_release_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No version is waiting for release (not approved yet?)") unless v
    v.create_app_store_version_release_request
    UI.success("Released #{v.version_string} — it appears in the App Store within about an hour")
  end
end

platform :android do
  desc "Read-only: can the service account see the app? Shows the production track"
  lane :check do
    validate_play_store_json_key(json_key: play_key)
    codes = google_play_track_version_codes(json_key: play_key, package_name: APP_ID, track: "production")
    UI.success("Play: #{APP_ID} production version codes: #{codes.inspect}")
    internal = google_play_track_version_codes(json_key: play_key, package_name: APP_ID, track: "internal") rescue []
    UI.message("  internal testing version codes: #{internal.inspect}")
  end

  desc "Upload Play listing screenshots and texts (no release)"
  lane :metadata do
    supply(json_key: play_key, package_name: APP_ID, skip_upload_aab: true, skip_upload_apk: true,
           skip_upload_changelogs: true, metadata_path: File.expand_path("metadata/android", __dir__))
  end

  desc "Upload an .aab to the production track as a DRAFT (send for review from Play Console or with release)"
  lane :submit do |options|
    aab = File.expand_path(options[:aab] || Dir[File.expand_path("~/Desktop/qode/apk/myQode-#{VERSION}-*.aab")].max_by { |f| f[/-(\d+)\.aab$/, 1].to_i })
    UI.user_error!("No .aab found") unless aab && File.exist?(aab)
    UI.message("Uploading #{File.basename(aab)}")
    supply(json_key: play_key, package_name: APP_ID, track: "production", release_status: "draft", aab: aab,
           metadata_path: File.expand_path("metadata/android", __dir__), skip_upload_images: false,
           skip_upload_screenshots: false)
  end

  desc "Publish the production draft to a share of users (rollout:0.2 = 20%, 1.0 = everyone)"
  lane :release do |options|
    code = options[:code] || UI.user_error!("Pass code:<versionCode> of the draft, e.g. code:52")
    fraction = (options[:rollout] || 1.0).to_f
    status = fraction >= 1.0 ? "completed" : "inProgress"
    supply(json_key: play_key, package_name: APP_ID, track: "production", release_status: status, version_code: code.to_i,
           rollout: (fraction >= 1.0 ? nil : fraction.to_s), skip_upload_aab: true, skip_upload_apk: true,
           skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true, skip_upload_changelogs: true)
  end
end
