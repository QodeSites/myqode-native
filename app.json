{
  "expo": {
    "name": "myQode",
    "slug": "myqode-native",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:onboarding.qodeinvest.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "myQode uses the camera for the selfie check during identity verification and to photograph your documents.",
        "NSPhotoLibraryUsageDescription": "myQode lets you choose photos of your documents from your library.",
        "NSMicrophoneUsageDescription": "Some verification steps record a short video and need the microphone."
      },
      "bundleIdentifier": "com.qodeinvest.myqode",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02422B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "onboarding.qodeinvest.com",
              "pathPrefix": "/onboard"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.qodeinvest.myqode",
      "versionCode": 46,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "myQode",
      "shortName": "myQode",
      "themeColor": "#02422B",
      "backgroundColor": "#001008"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "myQode uses the camera for the selfie check during identity verification and to photograph your documents.",
          "photosPermission": "myQode lets you choose photos of your documents from your library.",
          "microphonePermission": "Some verification steps record a short video and need the microphone."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "myQode uses Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      "./plugins/withSceneLifecycle",
      "./plugins/withReleaseSigning",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#02422B",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "myqode",
    "owner": "qodetech",
    "extra": {
      "eas": {
        "projectId": "56cc6ed6-aa91-4589-842f-981cf576bf21"
      }
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
